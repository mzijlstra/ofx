# F9 step 1 (docs/plan.md "F9 design"): the search view. The tree (run.sh): a.ts, b.txt,
# src/{c.ts, index.ts, deep/{index.ts, d.TS}}, docs/notes.txt, .hid/e.ts, .f.ts, .git/g.ts,
# node_modules/h.ts, link -> src, docs/clink -> ../src/c.ts, long/<250 x>/m2.txt, zz/ with
# zz00000 .. zz10000.
settle
expect search=0 tabs=1 searchbar=0
# Ctrl+Shift+F: a tab of its own, its field with the keys, nothing searched yet
key ctrl-shift-f
wait-for 2000 search=1 tabs=2 tab=1 searchkeys=1 n=0 searchtext=- searchbar=1
shot search-empty.png
# As you type: searched 150 ms after the last change; anywhere in the name, case ignored; .git,
# node_modules, hidden files and the link to a folder left out, and said so
type INDEX
expect searchdue=1 n=0
idle
expect idlewoke=timer
wait-for 3000 searchdue=0 searchdone=1 n=2
expect idx=0 sel=index.ts seldir=src rows=11 searchinfo=2_found_·_skipped_1_node_modules,_3_hidden,_1_link_to_a_folder
shot search-results.png
# The field edits as the rename line does (Michael, 2026-10-28): Ctrl+A selects its text, not the
# results, and typing replaces it; Ctrl+V pastes the clipboard's first line; Home moves the caret
key ctrl-a
expect searchsel=0-5 marked=0
type deep
wait-for 3000 searchdue=0 searchdone=1 searchtext=deep n=1
clip-text src/IND\nsecond line
key ctrl-a
key ctrl-v
wait-for 3000 searchdue=0 searchdone=1 searchtext=srcIND n=0 searchcaret=6
key home
expect searchcaret=0 searchsel=0-0
shot search-field.png
keys backspace
key end
keys backspace backspace backspace backspace backspace backspace
type INDEX
wait-for 3000 searchdue=0 searchdone=1 n=2 idx=0
# Enter: the keys to the results; there Enter opens the file, in its own folder
key enter
expect searchkeys=0
point-ui search-field
click-here
expect searchkeys=1
key enter
expect searchkeys=0
key down
expect idx=1 sel=index.ts seldir=src/deep
key enter
sh grep -qx "uwsm-app -- gio open $OFX_DIR/src/deep/index.ts" "$OFX_ROOT/spawn.log"
# A folder: entered in the same tab; Back is the search again (run again: a file made meanwhile is
# there), the cursor on it when it comes (folders first: deep, node_modules, then the files)
key ctrl-shift-f
expect searchkeys=1
keys backspace backspace backspace backspace backspace
type de
wait-for 3000 searchdue=0 searchdone=1 n=4 idx=0 sel=deep seldir=src
key enter
key down
expect idx=1 sel=node_modules seldir=-
key enter
wait-for 2000 search=0 back=1 n=1 searchbar=0
sh touch "$OFX_ROOT/home/tree/src/dex.txt"
key alt-left
wait-for 3000 search=1 searchdone=1 n=5 idx=1 sel=node_modules searchtext=de searchkeys=0
# A wildcard over the whole name, case ignored; Alt+C: case as typed
key ctrl-shift-f
keys backspace backspace
type *.ts
wait-for 3000 searchdue=0 searchdone=1 n=5
point-ui toggle 11
click-here
wait-for 3000 searchdone=1 n=4 findopts=c
# Show Hidden Files: the hidden ones too, .git still not (from the field: the keys go to the results)
key ctrl-h
wait-for 3000 searchdone=1 n=6 shown=1 searchkeys=0
expect searchinfo=6_found_·_skipped_1_.git,_1_node_modules,_1_link_to_a_folder
key ctrl-h
wait-for 3000 searchdone=1 n=4 shown=0
key ctrl-shift-f
key alt-c
wait-for 3000 searchdone=1 n=5 findopts=-
# A regular expression that doesn't compile: nothing, its reason in the bar
key alt-r
keys backspace backspace backspace backspace
type (
wait-for 3000 searchdue=0 searchdone=1 searchbad=1 n=0
shot search-bad.png
key alt-r
keys backspace
# The limit: 10,000 shown, and said so
type zz
wait-for 8000 searchdue=0 searchdone=1 searchfull=1 n=10000
# Working with results (step 2, 2026-10-28), each in its own folder. Rename: there, the row
# taking the new name in place, the cursor on it
key ctrl-shift-f
keys backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace
type c.ts
wait-for 3000 searchdue=0 searchdone=1 n=1 sel=c.ts seldir=src
key enter
key f2
key home
type re-
key enter
wait-for 2000 editing=0 n=1 sel=re-c.ts seldir=src
sh test -f "$OFX_DIR/src/re-c.ts" && test ! -e "$OFX_DIR/src/c.ts"
# Undo: renamed back, so the result's name is gone (no watching); Ctrl+R finds it again
key ctrl-z
wait-for 2000 n=0
sh test -f "$OFX_DIR/src/c.ts"
key ctrl-r
wait-for 3000 searchdone=1 n=1 sel=c.ts
# Make Link and Duplicate: beside it, in its folder
key ctrl-m
wait-for 2000 status=Made
sh test -L "$OFX_DIR/src/Link to c.ts"
key alt-e
point-menu duplicate
click-here
wait-for 3000 jobs=0 n=1
sh sleep 0.3; ls "$OFX_DIR/src" | grep -q "^c (copy)"
# Trash: it leaves the list; Ctrl+Z brings it back
key delete
wait-for 2000 n=0 status=Trashed
sh test ! -e "$OFX_DIR/src/c.ts"
key ctrl-z
wait-for 2000 n=1 sel=c.ts
# Open Containing Folder (Ctrl+Enter): its folder, it selected; Back is the search, run again
# (Link to c.ts found now)
key ctrl-enter
wait-for 2000 search=0 crumbs=home|tree|src sel=c.ts
key alt-left
wait-for 3000 search=1 searchdone=1 n=2
# Terminal Here: in the folder searched; a paste or a new folder: not in a search
key alt-enter
sh grep -qx "uwsm-app -- xdg-terminal-exec --dir=$OFX_DIR" "$OFX_ROOT/spawn.log"
key ctrl-shift-n
expect status=A
key ctrl-v
expect status=A
# The same name in two folders: only the one renamed changes, the cursor following it to its row
key ctrl-shift-f
keys backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace
type index
wait-for 3000 searchdue=0 searchdone=1 n=2
key enter
key down
expect idx=1 seldir=src/deep
key f2
key home
type a-
key enter
wait-for 2000 editing=0 n=2 idx=0 sel=a-index.ts seldir=src/deep
key down
expect idx=1 sel=index.ts seldir=src
key ctrl-z
wait-for 2000 n=1 sel=index.ts
# A folder renamed: the results below it leave the list too (reviewer-2, 2026-10-28); Ctrl+Z puts
# them back (deep, node_modules, then dex.txt, index.ts twice)
key ctrl-shift-f
keys backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace
type de
wait-for 3000 searchdue=0 searchdone=1 n=5 idx=0 sel=deep
key enter
key f2
key home
type x
key enter
wait-for 2000 editing=0 n=4 sel=xdeep seldir=src
key ctrl-z
wait-for 2000 n=4 status=Undid
key end
expect sel=index.ts seldir=src/deep
sh test -d "$OFX_DIR/src/deep"
# The "Search" path button's folder menu: the folder searched, never the search's address (a
# bookmark of it went into the GTK file as file://search:…, reviewer-2, 2026-10-28)
point-ui crumb 0
right-here
expect menu=folder
point-menu bookmark-it
click-here
wait-for 2000 bmn=1
sh grep -qx "file://$OFX_DIR" "$OFX_ROOT/config/gtk-3.0/bookmarks" && ! grep -q "search:" "$OFX_ROOT/config/gtk-3.0/bookmarks"
# Delete for good, asked first: gone from the list and the disk
key ctrl-shift-f
keys backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace
type Link to
wait-for 3000 searchdue=0 searchdone=1 n=1 seldir=src
key enter
key shift-delete
expect confirming=1
char y
wait-for 3000 n=0 confirming=0
sh test ! -e "$OFX_DIR/src/Link to c.ts"
# Search in Folder…, on a folder result: a search below it, in a tab of its own
key ctrl-shift-f
keys backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace
type src
wait-for 3000 searchdue=0 searchdone=1 n=1 sel=src
key enter
point-ui row 0
right-here
expect menu=entry
point-menu search-in
click-here
wait-for 2000 search=1 tabs=3 searchkeys=1 searchtext=-
key ctrl-w
wait-for 2000 tabs=2 search=1
# A result whose folder and name are longer than a name keeps the cursor as more come (Ctrl+R
# here; reviewer-2, 2026-10-28: it went to the row, another file)
key ctrl-shift-f
keys backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace backspace
type m?.txt
wait-for 3000 searchdue=0 searchdone=1 n=1 sel=m2.txt
sh touch "$OFX_DIR/m1.txt"
key enter
key ctrl-r
wait-for 3000 searchdone=1 n=2 idx=1 sel=m2.txt
# Ctrl+R: searched again (no watching)
key ctrl-shift-f
keys backspace backspace backspace backspace backspace backspace
type notes
wait-for 3000 searchdue=0 searchdone=1 n=1
sh touch "$OFX_DIR/src/notes2.txt"
key enter
key ctrl-r
wait-for 3000 searchdone=1 n=2
# Follow Link on a result: its target's folder, the target selected (reviewer-2, 2026-10-28)
key ctrl-shift-f
keys backspace backspace backspace backspace backspace
type clink
wait-for 3000 searchdue=0 searchdone=1 n=1 sel=clink seldir=docs
key enter
point-ui row 0
right-here
expect menu=entry sel=clink
point-menu follow
click-here
wait-for 2000 search=0 crumbs=home|tree|src sel=c.ts
key alt-left
wait-for 3000 search=1 searchdone=1 n=1 sel=clink
# Alt+Up: the folder searched
key alt-up
wait-for 2000 search=0 searchbar=0 n=9
# The magnifier and Go → Search…: a search tab each, on the folder shown
point-ui search
click-here
wait-for 2000 search=1 tabs=3 tab=2 searchkeys=1
key ctrl-w
wait-for 2000 tabs=2 search=0 searchkeys=0
key alt-g
point-menu search
click-here
wait-for 2000 search=1 tabs=3 searchkeys=1
key ctrl-w
wait-for 2000 tabs=2 search=0 searchkeys=0
quit
