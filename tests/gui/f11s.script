# F11 milestone review, after f11r and run.sh's newer kept line (sub1 alone): a plain start brings it
# back as a step, so Back doesn't lead to the folder ofx was started on.
settle
expect tabs=1 tabdirs=sub1 back=0 modal=restore
type n
expect modal=-
# Reopen Closed Tab at the most tabs (32): said, the closed one kept for when one closes (F11 review)
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
key ctrl-t
expect tabs=32
key ctrl-w
expect tabs=31
key ctrl-t
expect tabs=32
key ctrl-shift-t
expect tabs=32 statusbad=1 status=32 most closedtabs=1
key ctrl-w
expect tabs=31
key ctrl-shift-t
expect tabs=32
quit
