# Browse a scratch tree made by tests/gui/run.sh: <T>/tree holds adir/ (inner.txt), bdir/,
# a.txt, b2.txt, b10.txt and .hidden. spawn.log is <T>/spawn.log, the theme <T>/state.
settle
expect n=5 hidden=1 sel=adir idx=0 scale=2
# The window's environment (run-script): no session bus, its runtime folder the run's own (a program
# with file capabilities looks for the bus there: F16 step 6 review), the display by its full path.
sh [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ "$XDG_RUNTIME_DIR" = "$OFX_ROOT/xdg-run" ] && [ ! -e "$XDG_RUNTIME_DIR/bus" ] && [ -S "$WAYLAND_DISPLAY" ]
char j
expect sel=bdir
key down
expect sel=a.txt icon=/usr/share/icons/Yaru/24x24@2x/mimetypes/text-plain.png
char G
expect sel=b10.txt
char g
expect sel=adir
key enter
expect sel=inner.txt n=1
key backspace
expect sel=adir n=5
# Up selects the folder left even when the one above remembers another cursor (b10.txt, where it
# was left for Back's adir).
key end
key alt-left
expect sel=inner.txt n=1
key backspace
expect sel=adir n=5
key right
char h
expect sel=adir
# Up from a folder that isn't the first: that folder is selected again.
char j
key enter
key backspace
expect sel=bdir idx=1
char k
# Open and terminal: the fakes log them.
key end
key enter
expect status=opened
sh grep -qx "uwsm-app -- gio open $OFX_DIR/b10.txt" "$OFX_ROOT/spawn.log"
char t
expect status=terminal
sh grep -qx "uwsm-app -- xdg-terminal-exec --dir=$OFX_DIR" "$OFX_ROOT/spawn.log"
# Live refresh: create, delete, rename.
sh touch "$OFX_DIR/new.txt"
wait-for 1000 n=6 sel=b10.txt
# A file sorting before the cursor: the cursor stays on its name, a row further down.
sh touch "$OFX_DIR/0first.txt"
wait-for 1000 n=7 sel=b10.txt idx=5
sh rm "$OFX_DIR/0first.txt"
wait-for 1000 n=6 sel=b10.txt idx=4
sh rm "$OFX_DIR/b10.txt"
wait-for 1000 n=5 sel=new.txt idx=4
sh mv "$OFX_DIR/new.txt" "$OFX_DIR/zz.txt"
wait-for 1000 n=5 sel=zz.txt
# A new folder sends only IN_CREATE (touch also closes the file).
sh mkdir "$OFX_DIR/cdir"
wait-for 1000 n=6 sel=zz.txt
# Mouse: a press selects, a second within 400 ms opens; the back button goes up.
press 1
expect sel=bdir
press 0
press 0
expect n=1 sel=inner.txt
back
expect sel=adir n=6
shot browse.png
# The theme: the scratch copy's accent changes, on backgrounds it reads on whatever Michael's theme is
# (theme_fit moves an accent that doesn't, 2026-11-07).
sh sed -i 's/^accent = .*/accent = "#123456"/; s/^background = .*/background = "#ffffff"/; s/^lighter_background = .*/lighter_background = "#ffffff"/; s/^selection = .*/selection = "#ffffff"/; s/^foreground = .*/foreground = "#000000"/' "$OFX_ROOT/state/omarchy/current/theme/colors.toml"
wait-for 1500 themes=1 accent=#123456
shot theme.png
quit
