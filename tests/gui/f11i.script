# F11 step 3: started on a folder other than home (sub1): it is shown, the tabs kept (sub2, from
# f11h's close) behind it. Then No to the question for run.sh's two lines: forgotten.
settle
expect tabs=2 tab=0 tabdirs=sub1|sub2 modal=restore status=-
type n
expect modal=-
sh [ "$(grep -c '^window ' "$OFX_ROOT/state/ofx/state")" = 1 ] && grep -q "^window $(cat "$OFX_ROOT/run.pid") [0-9]* [0-9]* open:" "$OFX_ROOT/state/ofx/state"   # (its own running line alone, F11 step 3b)
key ctrl-w
quit
