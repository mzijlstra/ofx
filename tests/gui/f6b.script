# F6, after f6.script on the same scratch tree: the sidebar's mode came back from the state file;
# a mode button clicked changes it. run.sh makes the drives' space 10 s late: the window answers
# meanwhile, without it.
settle
expect sidemode=hidden spaced=0
point-ui mode 1
click-here
expect sidemode=tree treehere=1
sh grep -qx sidebar=tree "$OFX_ROOT/state/ofx/state"
point-ui mode 0
click-here
expect sidemode=places sides=^Drives|File_System|^Places|Home|Bee|Trash spaced=0
key down
expect sel=a.txt
quit
