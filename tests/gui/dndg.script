# F14 step 1: every file marked, dragged out with move offered too (drag-out move): the target
# (dndpeer target-move) takes the move. ofx only sees what the target does with them (nothing:
# dndpeer moves no files). Layout as dnd.script.
settle
sh dndpeer target-move "$OFX_ROOT/peer.log" >/dev/null 2>&1 &
sleep 800
settle
key ctrl-a
sh vptr move 200 300 press wait 1500 move 300 300 move 650 250 move 700 250 wait 300 release >"$OFX_ROOT/vptr.log" 2>&1 &
wait-for 3000 dndpress=1
drag-out move
wait-for 4000 dndout=done dndoutact=2
sh grep -q "source actions 3$" "$OFX_ROOT/peer.log"
sh tr -d '\r\n' < "$OFX_ROOT/peer.log" | grep -q "bytes: file://$OFX_DIR/adirfile://$OFX_DIR/a.txtfile://$OFX_DIR/b.txt"
expect n=3
quit
