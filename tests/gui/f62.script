# F6.2: the icon view. run.sh's tree: adir, bdir, "a rather long file name that wraps over
# lines.txt", f01 .. f20, verylongnamewithoutanybreaksatallhere.bin (24 entries). The window is
# 936x490: 6 columns of cells beside the sidebar, 3 rows of them (rows 0-5, 6-11, 12-17, 18-23).
settle
expect view=list cols=1 iconpx=24 icontex=48 cells=0
# Ctrl+2 through the key callback (GLFW_KEY_2 is 50, Ctrl 2), as the keyboard gives it.
raw-key 50 2
expect view=icons cols=6 rows=3 cells=18 cellfirst=0 celllast=17 iconpx=48 idx=0 top=0
# Its own texture, not the list's stretched: 48 px at the test's scale 2.
expect icontex=96
sleep 300
sh grep -q "^folder $OFX_DIR [0-9]* icons " "$OFX_ROOT/state/ofx/state"   # (the folder's own, F11)
# Left and Right a cell, Up and Down a row; the scroll a row at a time.
key right
expect idx=1
key down
expect idx=7 top=0
key down
key down
expect idx=19 top=6 cells=18 cellfirst=6 celllast=23
key end
expect idx=23 top=6
key up
expect idx=17
key home
expect idx=0 top=0 cellfirst=0
char l
char j
expect idx=7
key pagedown
expect idx=19 top=6
key pageup
expect idx=7
# Left doesn't go up in the grid; Left and Right run across a row's end, and round the ends
# (Michael, 2026-10-25).
key home
key left
expect idx=23 back=0
key right
expect idx=0 sel=adir
key end
key right
expect idx=0
key up
expect idx=18
key down
expect idx=0
key home
key right
key right
key right
key right
key right
key right
expect idx=6 sel=f04
# The wheel a row a notch, the cursor stays.
key home
wheel -1
expect top=6 idx=0
wheel -5
expect top=6
wheel 3
expect top=0
# The name under the pointer: two lines, cut; the cursor's in full, never cut.
point-ui row 2
hover-here
expect hover=2 celllines=2 cellcut=1
press 2
expect idx=2 cellcut=0
# A press on the full name's third line, which lies over the cell below, is that cell's (8).
point-ui cell-full-line 2
click-here
expect idx=8
press 2
# A press on a cell in the second row, hit-tested as the mouse's.
point-ui row 9
click-here
expect idx=9
# Ctrl and Shift mark cells.
press 3 ctrl
press 5 ctrl
expect marked=2 idx=5
press 8 shift
expect marked=5
key esc
expect marked=0
# Enter and a double click open; Backspace goes up, back onto the folder left.
key home
key enter
expect sel=inner.txt view=list
key backspace
expect sel=adir view=icons
press 1
press 1
expect sel=bin.txt
key backspace
expect sel=bdir
# A middle click: a folder in a background tab.
middle 0
expect tabs=2 tab=0
key ctrl-tab
key ctrl-w
expect tabs=1 view=icons
# F2: the edit line on the cell; Esc keeps the name.
press 3
key f2
expect editing=1 edit=f01
shot rename.png
key esc
expect editing=0 sel=f01
# The list again: the cursor stays, one entry a row (Ctrl+1 through the callback); and back.
raw-key 49 2
expect view=list cols=1 idx=3 iconpx=24
sleep 300
sh grep -q "^folder $OFX_DIR [0-9]* - " "$OFX_ROOT/state/ofx/state"   # (the default again: unset)
key ctrl-2
expect view=icons cols=6 idx=3
# The sidebar hidden: 8 columns in the wider room, then 6 again (F9: tree, hidden, places).
key f9
key f9
expect sidemode=hidden cols=8 cells=24
key f9
expect sidemode=places cols=6
# The view buttons in the top bar.
point-ui view-list
click-here
expect view=list
point-ui view-icons
click-here
expect view=icons cols=6
# Ctrl and an arrow (GLFW's 265 up, 262 right): the path buttons, the location line.
raw-key 265 2
expect crumbfocus=1
key esc
expect crumbfocus=0 crumbkey=-
raw-key 262 2
expect locating=1
# (in the line Ctrl+Right is a word now, 2026-10-28: it stays open; Ctrl+L closes it)
raw-key 262 2
expect locating=1
key ctrl-l
expect locating=0
# Find works in the grid: the cursor goes there, the scroll follows.
type /very
key enter
expect idx=23 top=6
# The cache never filled.
expect iconresets=0
# Tooltips (Michael, 2026-10-24): after 600 ms on an icon button; the window asleep meanwhile is
# woken by the timer, not the 3 s stand-in. (First the view's own write, 100 ms in a test, done: its
# timer would wake the window before the tooltip's.)
sleep 300
point-ui search
hover-here
expect tooltip=-
idle
expect idlewoke=timer tooltip=Search_(Ctrl+Shift+F)
shot tip-search.png
# Another button: gone at once, its own after the wait; a key takes it away while the pointer stays.
point-ui view-icons
hover-here
expect tooltip=-
sleep 700
expect tooltip=Icons_(Ctrl+2)
shot tip-icons.png
key down
expect tooltip=-
sleep 700
expect tooltip=-
# The bottom bar's mode buttons; off any button, none.
point-ui mode 1
hover-here
sleep 700
expect tooltip=Tree_(F9)
shot tip-mode.png
point-ui row 0
hover-here
sleep 700
expect tooltip=-
shot icons.png
quit
