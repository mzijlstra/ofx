# F11 step 3, after f11f's Close All and run.sh's older line for window 4242 (sub2): the newest
# (f11f's) here, and the question for the other; y starts it on its id.
settle
expect tabs=2 tabdirs=tree|sub1 modal=restore
shot restore-windows.png
type y
expect modal=-
sh for i in $(seq 20); do grep -q "^uwsm-app -- /.*/ofx[^ /]* --restore 4242$" "$OFX_ROOT/spawn.log" && exit 0; sleep 0.1; done; exit 1
sh grep -q "^window 4242 " "$OFX_ROOT/state/ofx/state"
key ctrl-w
quit
