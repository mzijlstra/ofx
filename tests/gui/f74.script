# F7.4: the Edit, View and Go menus, on the tree tests/gui/run.sh makes (see there): by the keys and
# by the pointer, what they grey, hide and mark, and that each entry does what its key does.
settle
expect n=4 sel=sub menu=-
# No bookmarks (F7.5): the Bookmarks menu has Add Bookmark only, without the line under it
key alt-b
expect menu=Bookmarks menuseps=0 bmn=0
key esc
# ---- Edit: nothing to undo or paste yet; Restore not shown outside the trash view
key alt-e
expect menu=Edit menuat=cut menugrey=undo,paste,restore menuhid=restore menumarked=-
shot menu-edit.png
key down
expect menuat=copy
key down
expect menuat=select-all
key enter
expect menu=- marked=4
# Invert Selection by the pointer: all four off
point-ui menu-title 1
click-here
expect menu=Edit menuat=-
point-ui menu-item 8
click-here
expect menu=- marked=0
# Select Items Matching… by the pointer: the bar as "Select"; Enter selects every match and closes it
point-ui menu-title 1
click-here
point-ui menu-item 7
click-here
expect menu=- finding=1 findkeys=1 findselect=1
pointer-off
type .txt
expect findn=3 findtext=1_of_3 sel=a.txt
shot select-match.png
key enter
expect finding=0 findselect=0 marked=3
key esc
expect marked=0
# Ctrl+Shift+A as GLFW gives it (A 65, Ctrl and Shift 3); Esc leaves the selection as it was
key space
expect marked=1
raw-key 65 3
expect findselect=1
type b
key esc
expect finding=0 marked=1
# A bad regular expression (Alt+R, "("): Enter keeps the selection and the bar (reviewer-2)
raw-key 65 3
key alt-r
type (
expect findbad=1 findselect=1
key enter
expect finding=1 findselect=1 marked=1
key esc
raw-key 65 3
key alt-r
key esc
expect finding=0 marked=1 findopts=-
key esc
key home
# Copy a.txt: Paste can be picked then
key down
expect sel=a.txt
key alt-e
key down
key enter
expect menu=- copied=-
key alt-e
expect menugrey=undo,restore
key esc
# Rename… opens the row's edit line
key alt-e
keys up up up
expect menuat=rename
key enter
expect editing=1 menu=-
key esc
expect editing=0
# Move to Trash on c.txt, then Undo puts it back
key end
expect sel=c.txt
key alt-e
keys up up
expect menuat=trash
key enter
wait-for 2000 n=3 undo=trash
key alt-e
expect menugrey=restore menuat=undo
key enter
wait-for 2000 n=4 sel=c.txt
key esc
# Delete… asks first; No keeps it
key alt-e
key up
expect menuat=delete
key enter
expect confirming=1 menu=-
key esc
expect confirming=0 n=4
# Duplicate: beside itself as "name (copy)", then "(copy 2)"; Ctrl+Z takes the last one away; two
# selected, both; the clipboard as it was (a.txt, copied above)
key end
expect sel=c.txt
point-ui menu-title 1
click-here
point-ui menu-item 10
click-here
wait-for 2000 n=5 undo=copy
sh test -f "$OFX_DIR/c (copy).txt" && [ "$(cat "$OFX_DIR/c (copy).txt")" = c ]
key end
expect sel=c.txt
point-ui menu-title 1
click-here
point-ui menu-item 10
click-here
wait-for 2000 n=6
sh test -f "$OFX_DIR/c (copy 2).txt"
key ctrl-z
wait-for 2000 n=5
sh test ! -e "$OFX_DIR/c (copy 2).txt" && rm "$OFX_DIR/c (copy).txt"
wait-for 2000 n=4
key home
key down
key space
key space
expect marked=2
point-ui menu-title 1
click-here
point-ui menu-item 10
click-here
wait-for 2000 n=6
sh test -f "$OFX_DIR/a (copy).txt" && test -f "$OFX_DIR/b (copy).txt"
pointer-off
key ctrl-z
wait-for 2000 n=4
key esc
key alt-e
expect menugrey=undo,restore
key esc
# ---- View: the places sidebar, sorted by name, the list; the zoom only in the icon view
key alt-v
expect menu=View menuat=reload menumarked=side-places,perms-cols,sort-name,view-list menugrey=zoom-in,zoom-out,zoom-reset menuhid=-
shot menu-view.png
key esc
# Show Hidden Files (checked once on)
point-ui menu-title 2
click-here
point-ui menu-item 6
click-here
wait-for 2000 shown=1 n=5
point-ui menu-title 2
click-here
expect menumarked=side-places,hidden,perms-cols,sort-name,view-list
point-ui menu-item 6
click-here
wait-for 2000 shown=0 n=4
# Sort by Size, then Reverse Order; Sort by Name keeps the order reversed
point-ui menu-title 2
click-here
point-ui menu-item 10
click-here
expect sort=size rev=0
point-ui menu-title 2
click-here
point-ui menu-item 12
click-here
expect sort=size rev=1
point-ui menu-title 2
click-here
point-ui menu-item 9
click-here
expect sort=name rev=1
point-ui menu-title 2
click-here
expect menumarked=side-places,perms-cols,sort-name,sort-reverse,view-list
point-ui menu-item 12
click-here
expect rev=0
# The sidebar's modes
point-ui menu-title 2
click-here
point-ui menu-item 3
click-here
expect sidemode=tree
point-ui menu-title 2
click-here
point-ui menu-item 4
click-here
expect sidemode=hidden
point-ui menu-title 2
click-here
point-ui menu-item 2
click-here
expect sidemode=places
# Icons; then the zoom: Normal Size greyed at 48 px, Zoom In makes it 64, Normal Size back
point-ui menu-title 2
click-here
point-ui menu-item 19
click-here
expect view=icons
point-ui menu-title 2
click-here
expect menumarked=side-places,perms-cols,sort-name,view-icons menugrey=zoom-reset
point-ui menu-item 14
click-here
expect zoom=64
point-ui menu-title 2
click-here
expect menugrey=-
point-ui menu-item 16
click-here
expect zoom=48
point-ui menu-title 2
click-here
point-ui menu-item 18
click-here
expect view=list
pointer-off
# Reload lists the folder again
key alt-v
expect menuat=reload
key enter
expect menu=- reloadasked=1
# ---- Go: no history yet; by the keys Open Parent, then the rest by the pointer
key alt-g
expect menu=Go menuat=parent menugrey=back,forward menuhid=- menumarked=-
shot menu-go.png
key enter
wait-for 2000 n=1 sel=tree
key alt-g
expect menugrey=forward
key down
expect menuat=back
key enter
wait-for 2000 n=4 sel=c.txt
point-ui menu-title 3
click-here
expect menugrey=back
point-ui menu-item 2
click-here
wait-for 2000 n=1 sel=tree
key alt-left
wait-for 2000 n=4
key end
point-ui menu-title 3
click-here
point-ui menu-item 4
click-here
wait-for 2000 n=1 sel=tree
key alt-left
wait-for 2000 n=4
# Trash: the trash view; there Edit hides Move to Trash and shows Restore, Go greys the terminal
point-ui menu-title 3
click-here
point-ui menu-item 5
click-here
wait-for 2000 trash=1
pointer-off
key alt-e
expect menuhid=trash
key esc
key alt-g
expect menugrey=parent,forward,terminal
key esc
key alt-left
wait-for 2000 trash=0 n=4
# Find in Folder…, Location…, Terminal Here
key alt-g
keys up up up
expect menuat=find
key enter
expect finding=1 findkeys=1 menu=-
key esc
key alt-g
keys up up
expect menuat=location
key enter
expect locating=1 menu=-
key esc
key alt-g
key up
expect menuat=terminal
key enter
expect menu=-
sh grep -qx "uwsm-app -- xdg-terminal-exec --dir=$OFX_DIR" "$OFX_ROOT/spawn.log"
# ---- the new keys as GLFW gives them: Ctrl+Shift+I (I 73, Ctrl and Shift 3), Ctrl+R (R 82,
# Ctrl 2), Alt+Home (Home 268, Alt 4)
raw-key 73 3
expect marked=4
raw-key 73 3
expect marked=0
raw-key 82 2
expect reloadasked=2
raw-key 268 4
wait-for 2000 n=1 sel=tree
# Michael's keys (2026-10-27): Shift+Enter (Enter 257, Shift 1) Open With on the cursor's entry;
# Alt+End (End 269, Alt 4) the trash view
raw-key 257 1
wait-for 2000 ow=1 modal=open-with owtype=inode/directory
key esc
expect ow=0
raw-key 269 4
wait-for 2000 trash=1
quit
