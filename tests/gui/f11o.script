# F11 step 3b, after f11n's crash: a plain start brings that window back without asking (one window,
# as the last one closed would be: Michael, 2026-11-02), and its line is taken.
settle
expect tabs=2 tab=1 tabdirs=tree|sub2 modal=- status=-
sh ! grep -q "^window $(cat "$OFX_ROOT/f11n.pid") " "$OFX_ROOT/state/ofx/state"
quit
