# F8 step 3: a folder elsewhere's menu: a place (a bookmark, Home, Trash), a tree row, a path button,
# by the pointer and by Shift+F10 where the keys are. The tree (run.sh): sub/, sub2/; the bookmarks
# file in the scratch config: home/tree/sub "Sub", then home/tree/sub2. The sidebar: Drives,
# File System, Places, Home, Sub, sub2, Trash.
settle
expect sides=^Drives|File_System|^Places|Home|Sub|sub2|Trash bmn=2
# A heading: nothing
point-ui side-row 0
right-here
expect menu=-
# A bookmark's row: Edit Bookmarks' own; no Cut or Copy (a place), no Add Bookmark (one already)
point-ui side-row 4
right-here
expect menu=folder menuhid=cut-it,copy-it,bookmark-it,eject,empty-it menugrey=cut-it,copy-it,paste-into,bookmark-it,bm-up,eject,empty-it menuin=1
shot ctx-bookmark.png
key esc
# Another writer changes the file under an open menu: it closes, its line read again would be another
point-ui side-row 5
right-here
expect menu=folder
sh sed -i "1i file://$OFX_DIR New" "$OFX_ROOT/config/gtk-3.0/bookmarks"
wait-for 3000 bmn=3 menu=-
sh sed -i 1d "$OFX_ROOT/config/gtk-3.0/bookmarks"
wait-for 3000 bmn=2
point-ui side-row 4
right-here
# Move Down: the file's order changes, the places follow
point-menu bm-down
click-here
wait-for 2000 sides=^Drives|File_System|^Places|Home|sub2|Sub|Trash
sh [ "$(head -1 "$OFX_ROOT/config/gtk-3.0/bookmarks")" = "file://$OFX_DIR/sub2" ]
# Rename…: Edit Bookmarks on that line, its field open with the label
point-ui side-row 5
right-here
point-menu bm-rename
click-here
expect menu=- bmp=1 bmpsel=1 bmpnaming=1 bmptext=Sub
key esc
key esc
expect bmp=0
# Remove: the line goes
point-ui side-row 4
right-here
point-menu bm-remove
click-here
wait-for 2000 sides=^Drives|File_System|^Places|Home|Sub|Trash bmn=1
sh ! grep -q "tree/sub2" "$OFX_ROOT/config/gtk-3.0/bookmarks"
# Home: Open in New Tab, a tab behind on it; Add Bookmark there
point-ui side-row 3
right-here
expect menu=folder menuhid=cut-it,copy-it,bm-rename,bm-up,bm-down,bm-remove,bm-edit,eject,empty-it
point-menu open-tab
click-here
expect menu=- tabs=2 tab=0
# A tab's menu: the tab right-clicked shown; Move Tab Left; Close Other Tabs
point-ui tab 1
right-here
expect menu=tab tab=1 menugrey=tab-right menuin=1
shot ctx-tab.png
point-menu tab-left
click-here
expect menu=- tab=0 tabdirs=home|tree
point-ui tab 0
right-here
expect menu=tab menugrey=tab-left
key esc
point-ui tab 1
right-here
expect menu=tab tab=1 menugrey=tab-right
point-menu tab-others
click-here
expect menu=- tabs=1 tabdirs=tree
# Trash: gone to, not into; Empty Trash greyed while it is empty
point-ui side-row 5
right-here
expect menu=folder menuhid=open-window,terminal-in,search-in,cut-it,copy-it,paste-into,bookmark-it,bm-rename,bm-up,bm-down,bm-remove,bm-edit,eject,properties-it
expect menugrey=open-window,terminal-in,search-in,cut-it,copy-it,paste-into,bookmark-it,bm-rename,bm-up,bm-down,bm-remove,bm-edit,eject,empty-it,properties-it
key esc
# Something in the trash: Empty Trash asks
key down
key delete
wait-for 2000 undo=trash n=1
point-ui side-row 5
right-here
expect menugrey=open-window,terminal-in,search-in,cut-it,copy-it,paste-into,bookmark-it,bm-rename,bm-up,bm-down,bm-remove,bm-edit,eject,properties-it
point-menu empty-it
click-here
expect menu=- modal=empty
type n
expect modal=-
# A path button: its folder's Properties; Open in Terminal there
point-ui crumb 0
right-here
expect menu=folder
point-menu properties-it
click-here
expect menu=- props=1 propname=home
key esc
point-ui crumb 0
right-here
point-menu terminal-in
click-here
sh grep -qx "uwsm-app -- xdg-terminal-exec --dir=$OFX_ROOT/home" "$OFX_ROOT/spawn.log"
# The tree: a folder's Cut and Copy (not a place); Copy then Paste Into Folder from the files
key f9
wait-for 2000 sidemode=tree
point-ui side-row 0
right-here
expect menu=folder menuhid=bm-rename,bm-up,bm-down,bm-remove,bm-edit,eject,empty-it
key esc
key f9
key f9
wait-for 2000 sidemode=places
# A path button's Copy is its folder's: tree, which can't be pasted into itself (the cursor's sub
# would paste as "sub (copy)")
point-ui crumb 1
right-here
expect menuhid=bm-rename,bm-up,bm-down,bm-remove,bm-edit,eject,empty-it
point-menu copy-it
click-here
expect menu=- clip=1 cut=0
key ctrl-v
sh sleep 1; test ! -e "$OFX_DIR/sub (copy)"
# With files copied, Paste Into Folder on a folder that takes them
point-ui side-row 4
right-here
expect menu=folder menugrey=cut-it,copy-it,bookmark-it,bm-up,bm-down,eject,empty-it
key esc
# Open: there
point-ui side-row 4
right-here
point-menu open-it
click-here
wait-for 2000 crumbs=home|tree|sub
key alt-left
wait-for 2000 crumb=1
# By the keys: the sidebar's cursor (Tab), the path buttons' (Ctrl+K); the keys stay there
key tab
key home
expect sidefocus=1 side=1
char j
expect side=3 place=Home
raw-key 299 1
expect menu=folder menuat=open-it menuin=1
# (under the cursor's sidebar row: Home)
expect menubox=12,184,280,243
key esc
expect menu=- sidefocus=1
key tab
key ctrl-k
expect crumbfocus=1
raw-key 348 0
expect menu=folder menuat=open-it
key esc
expect menu=- crumbfocus=1
quit
