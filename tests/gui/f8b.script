# F8 step 2: a folder's own entries (a window, a terminal, a bookmark, a paste into it), Make Link
# (Ctrl+M) and its undo, Follow Link. The tree (run.sh): sub/ with inner.txt, a.txt, zlink ->
# sub/inner.txt; the bookmarks file in the scratch config, none yet.
settle
expect n=3 sel=sub bmn=0 permscols=1
# The list (2026-10-27): a link's target after its arrow; Owner, Group, Permissions (room for them
# in the 936 px window with the sidebar since the cutoff went to 150; f8e is narrower). The sidebar
# off for the rest, as the shot was made.
expect permsshown=1 permsnote=0
key f9
key f9
wait-for 2000 sidemode=hidden permsshown=1
shot list-columns.png
# View → Show Permissions: off, remembered; on again
key alt-v
point-menu perms-cols
click-here
expect menu=- permscols=0 permsshown=0
sh grep -qx "perms=off" "$OFX_ROOT/state/ofx/state"
shot list-no-perms.png
key alt-v
point-menu perms-cols
click-here
expect permscols=1
sh grep -qx "perms=on" "$OFX_ROOT/state/ofx/state"
# Ctrl+P does the same; View → Show Group (Ctrl+G) adds Group, off at first, greyed and its key
# doing nothing while Show Permissions is off (2026-10-27)
expect groupcol=0 groupdrawn=0
key ctrl-g
expect groupcol=1 groupdrawn=2
sh grep -qx "group=on" "$OFX_ROOT/state/ofx/state"
shot list-group.png
key ctrl-p
expect permscols=0 groupcol=1 groupdrawn=0
sh grep -qx "perms=off" "$OFX_ROOT/state/ofx/state"
key alt-v
expect menugrey=group-col,zoom-in,zoom-out,zoom-reset
key esc
key ctrl-g
expect groupcol=1
key ctrl-p
expect permscols=1 groupdrawn=2
key alt-v
expect menumarked=side-none,perms-cols,group-col,colors,show-menu,sort-name,view-list
point-menu group-col
click-here
expect menu=- groupcol=0 groupdrawn=0
sh grep -qx "group=off" "$OFX_ROOT/state/ofx/state"
# View → Show Menu: off, a note says how the menus still open; F10 floats the bar over the top
# bar while a menu is open; remembered; back on from View
expect barhidden=0
key alt-v
point-menu show-menu
click-here
expect menu=- barhidden=1 barshown=0 modal=menubar
shot menubar-hidden.png
key enter
expect modal=-
sh grep -qx "menubar=off" "$OFX_ROOT/state/ofx/state"
key f10
expect menu=File
shot menubar-float.png
key esc
key alt-v
expect menu=View menumarked=side-none,perms-cols,colors,sort-name,view-list
point-menu show-menu
click-here
expect menu=- barhidden=0 modal=-
sh grep -qx "menubar=on" "$OFX_ROOT/state/ofx/state"
# Open in New Window: ofx on that folder
point-ui row 0
right-here
expect menu=entry menuhid=containing,follow,restore
point-menu open-window
click-here
expect menu=-
sh grep -qx "uwsm-app -- /.*/ofx[^ /]* $OFX_DIR/sub" "$OFX_ROOT/spawn.log"
# Open in Terminal: there, not in the folder shown
point-ui row 0
right-here
point-menu terminal-in
click-here
sh grep -qx "uwsm-app -- xdg-terminal-exec --dir=$OFX_DIR/sub" "$OFX_ROOT/spawn.log"
# Add Bookmark: that folder; then it isn't offered again
point-ui row 0
right-here
point-menu bookmark-it
click-here
wait-for 2000 bmn=1
sh grep -qx "file://$OFX_DIR/sub" "$OFX_ROOT/config/gtk-3.0/bookmarks"
point-ui row 0
right-here
expect menuhid=containing,follow,bookmark-it,restore
key esc
# Paste Into Folder: a.txt copied into sub, not here
key down
key ctrl-c
point-ui row 0
right-here
expect menugrey=containing,follow,bookmark-it,restore
point-menu paste-into
click-here
wait-for 3000 jobs=0 n=3
sh test -f "$OFX_DIR/sub/a.txt" && test -f "$OFX_DIR/a.txt"
# A folder into itself: refused
key home
key ctrl-c
point-ui row 0
right-here
point-menu paste-into
click-here
sh test ! -e "$OFX_DIR/sub/sub"
# Make Link: "Link to a.txt" beside it, selected, pointing at its full path; Ctrl+M on it again;
# Ctrl+Z takes back the last
point-ui row 1
right-here
point-menu make-link
click-here
wait-for 2000 n=4 idx=2
sh test "$(readlink "$OFX_DIR/Link to a.txt")" = "$OFX_DIR/a.txt"
# (Ctrl+M as the window gets it: M 77, Ctrl 2)
raw-key 77 2
wait-for 2000 n=5 undo=link
key ctrl-z
wait-for 2000 n=4
sh test -L "$OFX_DIR/Link to a.txt" && test ! -e "$OFX_DIR/Link to Link to a.txt"
# Follow Link: zlink's target's folder, the target selected
point-ui row 3
right-here
expect menu=entry sel=zlink menuhid=containing,open-tab,open-window,paste-into,terminal-in,search-in,bookmark-it,restore
point-menu follow
click-here
wait-for 2000 crumbs=home|tree|sub sel=inner.txt
quit
