# F16 step 2: a far folder (run.sh's tree/share, a gvfs FUSE mount by the mount list) is read by
# ofx-list, never by ofx: its listing, Can Write and item counts all come from the lister.
settle
expect faron=0 n=2 sel=local
key down
expect sel=share
key enter
wait-for 3000 faron=1 farloading=0 n=2 sel=sub canwrite=1 farnote=- statusbad=0
# The count of sub: asked of the lister for the row on screen (not the count thread: it would read
# the share itself). No free space said: statvfs there could hold ofx.
wait-for 3000 sizecell=3_items farasked=1
expect info=2_items_(1_hidden)
# Its lister's errors go to /dev/null, not ofx's stderr: one that outlives ofx in D would hold a
# pipe there open (step 2a review).
sh p=$(pgrep -f "ofx-list $OFX_DIR\$"); [ -n "$p" ] && [ "$(readlink /proc/$p/fd/2)" = /dev/null ]
# Show Hidden: listed again by a new lister (the last one killed), .dot with it.
key ctrl-h
wait-for 3000 n=3 hidden=1 farkills=1
key ctrl-h
wait-for 3000 n=2 farkills=2
# A share that can't be written: the lister says so.
sh chmod a-w "$OFX_DIR"
key ctrl-r
wait-for 3000 canwrite=0 farkills=3
sh chmod u+w "$OFX_DIR"
key ctrl-r
wait-for 3000 canwrite=1 farkills=4
# Back out: its lister killed, and gone from the kernel.
key backspace
wait-for 3000 faron=0 sel=share farkills=5 farheld=0 canwrite=1
# A slow drive: a lister that answers after 6 s. The list says Opening, then after 3 s that it
# isn't answering, while the window keeps answering (this script's lines go on); then the listing.
# (6 s: at 4 the answer came half a second after the 3 s note, which a loaded run could pass; the
# cleanup's step B.)
sh cp "$OFX_ROOT/fakes/ofx-list" "$OFX_ROOT/fakes/ofx-list.real" && printf '#!/bin/sh\nsleep 6\nexec "%s/fakes/ofx-list.real" "$@"\n' "$OFX_ROOT" > "$OFX_ROOT/fakes/ofx-list"
key enter
expect faron=1 farloading=1 farslow=0 n=0 canwrite=0 info=Opening… listword=Opening…
shot far-opening.png
# The window asleep meanwhile, as unscripted: the timer wakes it to say so (not the 3 s stand-in,
# which starts half a second later).
sleep 500
idle
expect idlewoke=timer farslow=1 statusbad=1 farnote=share_isn't_answering listword=share_isn't_answering
shot far-slow.png
key down
expect farloading=1
wait-for 5000 farloading=0 farslow=0 farnote=- n=2 statusbad=0
# A slow reload keeps the listing shown, and the cursor where it is moved meanwhile (step 2a review:
# it went back to where it was at Ctrl+R).
key home
key ctrl-r
expect farloading=1 sel=sub n=2
key down
expect sel=x.txt
wait-for 9000 farloading=0 sel=x.txt n=2
# Left before it answers: its lister killed, and its answer never shown.
key backspace
wait-for 3000 faron=0 sel=share
key enter
expect farloading=1
key backspace
wait-for 3000 faron=0 sel=share farheld=0
expect n=2 sel=share
# The folder gone meanwhile (the real lister back): listed again, the lister says so, and the
# nearest folder above is shown, as for a local folder gone (step 3; it stayed, with its error).
sh cp "$OFX_ROOT/fakes/ofx-list.real" "$OFX_ROOT/fakes/ofx-list"
key enter
wait-for 3000 faron=1 farloading=0 n=2
sh mv "$OFX_DIR" "$OFX_DIR.away"
key ctrl-r
wait-for 3000 faron=0 n=2 statusbad=1 farnote=-
expect is gone
sh mv "$OFX_DIR/share.away" "$OFX_DIR/share"
key ctrl-r
wait-for 3000 faron=0 n=2
# Links into the share from a local folder (2b): local/nas (to the share) and local/doc (to its
# x.txt), taken for folders and never looked at. Enter on nas lists the share the far way; on doc,
# found a file, it comes back and opens it.
key home
expect sel=local
key enter
wait-for 3000 faron=0 n=5 sel=doc
# ghost: a link into the share to "Not a directory", which isn't there. Its reason is shown, not
# taken for a file because of the name (step 2b review).
key down
expect sel=ghost
key enter
wait-for 3000 faron=1 farloading=0 farnote=Not_a_directory:_No_such_file_or_directory
key alt-left
wait-for 3000 faron=0 sel=ghost
# mnt: a far drive's mount point, never looked at: its Owner and Permissions blank, no date.
key down
expect sel=mnt selowner=- selperms=- seldate=-
key down
expect sel=nas
# Its item count isn't asked (the count thread would read the share): "?".
wait-for 2000 sizecell=?
key enter
wait-for 3000 faron=1 farloading=0 n=2 sel=sub
key alt-left
wait-for 3000 faron=0 sel=nas
key home
expect sel=doc
key enter
wait-for 3000 faron=0 sel=doc
sh grep -q "share/x.txt" "$OFX_ROOT/spawn.log"
# The same with a reload before the lister answers (a slow one, 3 s: at 1 s the reload could come
# after the answer and the check passed either way; the cleanup's step B): the reload keeps how ofx
# got there, so the file is still opened (step 3: under load, it was taken for a folder's error).
sh printf '#!/bin/sh\nsleep 3\nexec "%s/fakes/ofx-list.real" "$@"\n' "$OFX_ROOT" > "$OFX_ROOT/fakes/slow" && chmod +x "$OFX_ROOT/fakes/slow" && mv "$OFX_ROOT/fakes/slow" "$OFX_ROOT/fakes/ofx-list"
key enter
expect faron=1 farloading=1
key ctrl-r
expect farloading=1
wait-for 8000 faron=0 sel=doc
sh [ "$(grep -c "share/x.txt" "$OFX_ROOT/spawn.log")" = 2 ]
sh cp "$OFX_ROOT/fakes/ofx-list.real" "$OFX_ROOT/fakes/real" && mv "$OFX_ROOT/fakes/real" "$OFX_ROOT/fakes/ofx-list"
key backspace
wait-for 3000 sel=local
# A reload before a plain listing's answer, the folder gone meanwhile: up to the folder above, as a
# reload of one listed (the reload's way replaces a plain one; the code-health review's step D).
sh printf '#!/bin/sh\nsleep 3\nexec "%s/fakes/ofx-list.real" "$@"\n' "$OFX_ROOT" > "$OFX_ROOT/fakes/slow" && chmod +x "$OFX_ROOT/fakes/slow" && mv "$OFX_ROOT/fakes/slow" "$OFX_ROOT/fakes/ofx-list"
key down
expect sel=share
key enter
expect faron=1 farloading=1
sh mv "$OFX_DIR" "$OFX_DIR.away"
key ctrl-r
expect farloading=1
wait-for 8000 faron=0 statusbad=1
expect is gone
sh mv "$OFX_DIR/share.away" "$OFX_DIR/share"
sh cp "$OFX_ROOT/fakes/ofx-list.real" "$OFX_ROOT/fakes/real" && mv "$OFX_ROOT/fakes/real" "$OFX_ROOT/fakes/ofx-list"
key ctrl-r
wait-for 3000 n=2
key home
expect sel=local
key down
expect sel=share
# A lister that ends without a word: said, not waited for.
sh printf '#!/bin/sh\nexit 0\n' > "$OFX_ROOT/fakes/ofx-list"
key enter
wait-for 3000 faron=1 farloading=0 statusbad=1 farnote=share:_its_reader_ended_without_an_answer
key backspace
wait-for 3000 faron=0 sel=share
# No ofx-list at all: the folder isn't entered, and the status line says why.
sh rm "$OFX_ROOT/fakes/ofx-list" "$OFX_ROOT/fakes/ofx-list.real"
key enter
expect faron=0 sel=share statusbad=1
expect needs ofx-list, which isn't installed
quit
