# F5 on a tree made by tests/gui/run.sh, HOME=<scratch>/home: home/tree holds adir/ (a1, a2),
# bdir/ (b1), cdir/, gone/ (g1) and f01..f40; tree/big.bin 8 MiB. Copies slowed
# (OFX_TEST_COPY_DELAY_MS).
settle
expect tabs=1 tab=0 tabdirs=tree
# ---- Ctrl+T: a tab on this folder, shown, history its own; the bar from two tabs on
key down
expect sel=bdir rows=14
key ctrl-t
wait 2
expect tabs=2 tab=1 tabdirs=tree|tree sel=bdir back=0 rows=13
shot tabs.png
key enter
expect tabdirs=tree|bdir back=1 sel=b1
key ctrl-tab
expect tab=0 tabdirs=tree|bdir sel=bdir back=0
key ctrl-tab
expect tab=1 sel=b1 back=1
key ctrl-shift-tab
expect tab=0
# ---- each tab keeps its selection and scroll
key home
key space
key space
expect marked=2 sel=cdir
key ctrl-tab
expect tab=1 marked=0
key ctrl-tab
expect tab=0 marked=2 sel=cdir
# A new tab on the same folder starts with nothing selected; the old one keeps its own
key ctrl-t
expect tabs=3 tab=1 marked=0 sel=cdir
key ctrl-w
expect tabs=2 tab=1 tabdirs=tree|bdir
key ctrl-shift-tab
expect tab=0 marked=2
key esc
key end
key up
key up
key up
key up
key up
expect sel=f35 top=32
key ctrl-tab
key ctrl-tab
expect sel=f35 top=32 marked=0
# ---- the sort belongs to the folder (F11): bdir keeps its own; tree's back to the default
char S
expect sort=name rev=1
key ctrl-tab
expect sort=name rev=0
key ctrl-tab
expect rev=1
char S
expect rev=0
# ---- Alt+N, Ctrl+PgUp/Down through the key callback, moving a tab
key alt-2
expect tab=1
# A digit without Alt is no tab
raw-key 49 0
expect tab=1
key alt-1
expect tab=0
key alt-9
expect tab=1
raw-key 266 2
expect tab=0
raw-key 267 2
expect tab=1
raw-key 266 3
expect tab=0 tabdirs=bdir|tree
raw-key 267 3
expect tab=1 tabdirs=tree|bdir
raw-key 84 2
expect tabs=3 tab=2 tabdirs=tree|bdir|bdir
raw-key 87 2
expect tabs=2 tab=1 tabdirs=tree|bdir
# ---- middle clicks open folders in background tabs; the cursor stays
key alt-1
key home
middle 0
expect tabs=3 tab=0 tabdirs=tree|adir|bdir sel=adir
key end
middle 0
point-ui crumb 0
middle-here
expect tabs=4 tab=0 tabdirs=tree|home|adir|bdir
point-ui side-row 1
middle-here
expect tabs=5 tab=0 tabdirs=tree|home|home|adir|bdir
# A file: not a folder
key end
middle 12
expect tabs=5 isn't
# ---- clicks on the tab bar: show, × closes, a middle click closes
point-ui tab 2
click-here
expect tab=2 tabdirs=tree|home|home|adir|bdir
point-ui tab-x 1
click-here
expect tabs=4 tab=1 tabdirs=tree|home|adir|bdir
point-ui tab 3
middle-here
expect tabs=3 tab=1 tabdirs=tree|home|adir
# ---- a tab whose folder is gone
key alt-1
key ctrl-t
char /
type gone
key enter
key enter
expect sel=g1 tab=1
key alt-1
sh rm -rf "$OFX_DIR/gone"
key alt-2
expect tab=1 tabdirs=tree|tree|home|adir gone sel=adir
key ctrl-w
# ---- a copy keeps running across a switch
key alt-1
char /
type big
key enter
key ctrl-c
key alt-3
expect tab=2
point-ui crumb 1
click-here
key home
key enter
key end
key ctrl-v
wait-for 3000 job=run
key alt-1
expect tab=0
wait-for 15000 job=- status=Copied
sh test -f "$OFX_ROOT/home/tree/adir/big.bin" && cmp -s "$OFX_ROOT/home/tree/adir/big.bin" "$OFX_ROOT/home/tree/big.bin"
key alt-3
expect tab=2 tabdirs=tree|home|adir n=3
# ---- a delete job finishing in another tab leaves this tab's selection, and the question there
# deletes what it asked about (deletes slowed by OFX_TEST_COPY_DELAY_MS, 150 ms an item)
sh mkdir -p "$OFX_ROOT/home/tree/del" "$OFX_ROOT/home/tree/keep" && cd "$OFX_ROOT/home/tree/del" && touch d01 d02 d03 d04 d05 d06 d07 d08 d09 d10 d11 d12 && touch ../keep/k1 ../keep/k2 ../keep/k3
key alt-1
wait-for 2000 tab=0
char /
type del
key enter
key enter
wait-for 2000 n=12
key ctrl-a
key shift-delete
key enter
wait-for 2000 job=run
key ctrl-t
key backspace
char /
type keep
key enter
key enter
expect n=3 sel=k1
key space
key space
expect marked=2 sel=k3
key shift-delete
expect confirming=1
# Its box's border red, as a question that destroys (panel_box, the code-health review's step E).
expect panelred=1
wait-for 5000 job=-
expect marked=2 confirming=1
key enter
wait-for 3000 job=- n=1 sel=k3
sh test -f "$OFX_ROOT/home/tree/keep/k3" && test ! -e "$OFX_ROOT/home/tree/keep/k1" && test ! -e "$OFX_ROOT/home/tree/keep/k2"
key ctrl-w
# ---- Ctrl+W down to the last; the last closes ofx
key ctrl-w
key ctrl-w
expect tabs=1
quits 5
key ctrl-w
