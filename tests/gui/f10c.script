# F10, after f10b on the same scratch tree: run.sh made config/ofx a file, so ofx.conf can't be
# made at the start. The status line says so, and the built-in options apply (the skip list too).
# Once it can be, Preferences makes it, and watches its new folder.
settle
expect conf=on:10485760:short:.git+node_modules confbad=0 statusbad=1
expect status=Can't make ofx.conf, so the built-in options apply:
sh rm "$OFX_ROOT/config/ofx"
sh mkdir -p "$OFX_ROOT/state/omarchy/defaults" && echo nvim > "$OFX_ROOT/state/omarchy/defaults/editor"
sh printf '#!/bin/sh\n' > "$OFX_ROOT/fakes/nvim" && chmod +x "$OFX_ROOT/fakes/nvim"
point-ui menu-title 1
click-here
point-menu preferences
click-here
expect menu=-
sh grep -qx "search-skip = node_modules" "$OFX_ROOT/config/ofx/ofx.conf"
sh printf 'date-format = iso\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 conf=on:10485760:iso:
quit
