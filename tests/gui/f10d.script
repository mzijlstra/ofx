# F10, after f10c on the same scratch tree: ofx.conf's whole folder removed while ofx runs (its
# watch ends, IN_IGNORED); Preferences makes it again and watches the new folder, so an edit
# applies (reviewer-2, 2026-11-01).
settle
expect conf=on:10485760:iso: confbad=0
sh rm -rf "$OFX_ROOT/config/ofx"
wait-for 3000 conf=on:10485760:short:.git+node_modules
point-ui menu-title 1
click-here
point-menu preferences
click-here
expect menu=-
sh grep -qx "search-skip = .git" "$OFX_ROOT/config/ofx/ofx.conf"
sh printf 'date-format = long\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 conf=on:10485760:long:
# Into ofx.conf's folder (run.sh's cfg, a link to it) and out: its watch is the folder's too, and
# leaving must not end it (2026-11-01)
key home
expect sel=cfg
key enter
wait-for 2000 n=1 sel=ofx.conf
key alt-left
wait-for 2000 sel=cfg
sh printf 'date-format = iso\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 conf=on:10485760:iso:
quit
