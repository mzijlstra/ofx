# F7.5: the Keyboard Shortcuts panel and the Help menu: F1 and Ctrl+F1, the filter, scrolling, Close.
settle
key f1
expect keys=1 modal=shortcuts keysn=113 keystop=0 keysrows=12 keysfirst=#Moving
shot shortcuts.png
# It takes every key: t filters (no terminal); the filter: words or a key
type trash
expect keysn=4 keysfirst=#Moving
shot shortcuts-trash.png
keys backspace backspace backspace backspace backspace
expect keysn=113
type alt+r
expect keysn=4 keysfirst=#Moving
keys backspace backspace backspace backspace backspace
# Scrolling: Down, End, Home; the wheel
key down
expect keystop=1 keysfirst=Up,_down
key home
expect keystop=0
wheel -2
expect keystop=2
key esc
expect keys=0 modal=-
sh ! grep -q xdg-terminal-exec "$OFX_ROOT/spawn.log" 2>/dev/null
# Ctrl+F1 (F1 290, Ctrl 2) opens it, F1 (no Ctrl) closes it
raw-key 290 2
expect keys=1
raw-key 290 0
expect keys=0
# Help → Keyboard Shortcuts by the pointer; Close
point-ui menu-title 5
click-here
expect menu=Help menuat=-
point-menu shortcuts
click-here
expect keys=1 menu=-
point-ui modal-no
click-here
expect keys=0
pointer-off
key alt-h
expect menu=Help menuat=shortcuts
key esc
# Help → About (2026-10-27): by the pointer; it takes every key (t: no terminal); Esc, Enter, Close
point-ui menu-title 5
click-here
point-menu about
click-here
expect modal=about menu=-
shot about.png
type t
key down
expect modal=about
key esc
expect modal=-
key alt-h
key up
expect menuat=about
key enter
expect modal=about
key enter
expect modal=-
key alt-h
key up
key enter
point-ui modal-no
click-here
expect modal=-
pointer-off
sh ! grep -q xdg-terminal-exec "$OFX_ROOT/spawn.log" 2>/dev/null
quit
