# F2 on a tree made by tests/gui/run.sh: adir/ (in-a.txt, mtime Feb 1), bdir/ (in-b.txt, Jan 15),
# apple.txt (30 B, Jan 3), Banana.txt (10 B, Jan 1), cherry.txt (20 B, Jan 2), .dot; bookmarks Bee
# (bdir) and Tree (the tree).
settle
expect n=5 hidden=1 shown=0 sort=name rev=0 sel=adir here=Tree
# Hidden files: . and Ctrl+H; the cursor stays.
char .
expect n=6 shown=1 sel=adir
key ctrl-h
expect n=5 shown=0 sel=adir
# On a file after the dot-file: the cursor stays on its name, a row further down.
char G
char .
expect n=6 sel=cherry.txt idx=5
char .
expect n=5 sel=cherry.txt idx=4
key home
# Sort by keys: s size, S reverse; folders stay first.
char s
expect sort=size rev=0 sel=adir
key end
expect sel=apple.txt idx=4
char S
expect sort=size rev=1 sel=apple.txt idx=2
key end
expect sel=Banana.txt idx=4
# By headers: a new column, the same again reverses.
header mtime
expect sort=mtime rev=0
key home
expect sel=bdir
key end
expect sel=apple.txt
header mtime
expect rev=1 sel=apple.txt idx=2
# A real click on the Size header, hit-tested on the frame.
point-ui col-size
click-here
expect sort=size rev=0
header name
expect sort=name rev=0
# Find: / then text, Backspace, Enter keeps, n and N, Esc puts back, Ctrl+F.
key home
char /
type an
expect finding=1 sel=Banana.txt miss=0 find=an
char z
expect miss=1 sel=adir
key backspace
expect miss=0 sel=Banana.txt
key enter
expect finding=1 findkeys=0 last=an sel=Banana.txt
char /
type e
expect sel=cherry.txt
key enter
char n
expect sel=apple.txt
char N
expect sel=cherry.txt
key ctrl-f
type ap
expect finding=1 sel=apple.txt
key esc
expect finding=0 sel=cherry.txt
# ---- the find bar (Michael, 2026-10-26): over the job rows, its own room; Up and Down the
# previous and next match; Enter gives the keys back, the bar stays; Ctrl+J back into it; the
# field and the × by the pointer
expect rows=14
char /
type a
expect finding=1 findkeys=1 rows=12 sel=adir findn=3 findat=1 findtext=1_of_3
shot find-bar.png
key down
expect findkeys=1 sel=apple.txt findtext=2_of_3
key up
expect findtext=1_of_3
# Backspace and a letter in one frame: the same length, another text, counted again
keys backspace char:d
expect find=d sel=adir findn=2 findtext=1_of_2
keys backspace char:a
expect find=a findn=3 findtext=1_of_3
key enter
expect finding=1 findkeys=0
key ctrl-j
expect findkeys=1
key enter
point-ui find-field
click-here
expect findkeys=1
# The chevrons: the next and previous match, round the list, the keys left where they are; their
# tooltips; inert with one match
point-ui find-next
click-here
expect sel=apple.txt findtext=2_of_3 findkeys=1
click-here
click-here
expect sel=adir findtext=1_of_3
point-ui find-prev
click-here
expect sel=Banana.txt findtext=3_of_3 findkeys=1
hover-here
idle
expect tooltip=Previous_match_(Up) tipin=1
point-ui find-next
hover-here
idle
expect tooltip=Next_match_(Down) tipin=1
# The last idle's 3 s stand-in, still asleep, doesn't end the next one (2026-10-28): this one spans it
point-ui row 0
hover-here
sleep 2100
point-ui find-prev
hover-here
expect tooltip=-
idle
expect idlewoke=timer tooltip=Previous_match_(Up)
shot find-chevrons.png
char n
expect find=an findn=1 sel=Banana.txt
click-here
point-ui find-prev
click-here
expect sel=Banana.txt findtext=1_of_1
key backspace
key enter
key end
expect findkeys=0 sel=cherry.txt findtext=3_matches
point-ui find-next
click-here
expect sel=adir findkeys=0 findtext=1_of_3
pointer-off
point-ui find-x
click-here
expect finding=0 findkeys=0 rows=14 findn=0 findtext=-
pointer-off
# Opened again: an empty bar counts nothing (reviewer-2: it showed the last find's count)
char /
expect finding=1 find=- findn=0 findtext=-
key esc
# ---- Shift and a move select what the cursor passes over (Michael, 2026-10-26): Shift+Down as
# GLFW gives it (264, Shift 1), J as Shift+j; Esc clears
key home
raw-key 264 1
expect sel=bdir marked=2
char J
expect sel=apple.txt marked=3
key esc
expect marked=0
# A tab change closes it (a tab doesn't keep its own find).
char /
type a
key ctrl-t
expect tabs=2 finding=0 findkeys=0
key ctrl-w
expect tabs=1 finding=0
# History: Enter, Backspace, Alt+Left twice, Alt+Right, the mouse's buttons.
key home
key enter
expect sel=in-a.txt back=1
key backspace
expect sel=adir back=2 fwd=0
key alt-left
expect sel=in-a.txt back=1 fwd=1
key alt-left
expect sel=adir back=0 fwd=2
key alt-right
expect sel=in-a.txt back=1 fwd=1
raw-button 4
expect sel=adir back=0 fwd=2
raw-button 5
expect sel=in-a.txt back=1 fwd=1
back
expect sel=adir back=0
forward
expect sel=in-a.txt
key backspace
# The sidebar: Tab (onto Tree, the place shown), k, Enter; a press; a real click on a row.
key tab
expect sidefocus=1 side=5 place=Tree
char k
expect side=4 place=Bee
key enter
expect sel=in-b.txt here=Bee
press-side 5
expect sel=adir here=Tree
point-ui side-row 4
click-here
expect sel=in-b.txt here=Bee
key esc
expect sidefocus=0
# Back over a folder deleted since: it is dropped, and the one before it opens.
key backspace
key home
key enter
expect sel=in-a.txt
key backspace
expect sel=adir
sh rm -rf "$OFX_ROOT/tree/adir"
wait-for 1500 n=4
key alt-left
expect fwd=1 n=4 skipped
key alt-left
expect sel=in-b.txt here=Bee
shot f2.png
# The find bar stays open in another folder; Esc there puts the cursor back where that folder
# opened, not at a place in the last one's list.
# (bdir gets more entries than the place the find began, so the clamp alone can't put it right.)
key backspace
sh for i in 1 2 3 4 5; do : > "$OFX_DIR/bdir/x$i"; done
key end
char /
type cherry
key enter
wait-for 2000 sel=cherry.txt finding=1 findkeys=0
key home
key enter
wait-for 2000 n=6 sel=in-b.txt finding=1
key ctrl-j
key esc
expect finding=0 sel=in-b.txt
quit
