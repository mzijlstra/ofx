# F11 step 3b, after f11p: another window running (run.sh's stand-in, in the window registry this
# time): this start is an extra window and takes nothing, f11p's kept line stays.
settle
expect tabs=1 modal=-
sh grep -q "^window $(cat "$OFX_ROOT/f11p.pid") [0-9]* [0-9]* closed " "$OFX_ROOT/state/ofx/state"
sh kill "$(cat "$OFX_ROOT/other.pid")" && rm "$OFX_ROOT/windows/$(cat "$OFX_ROOT/other.pid")"
quit
