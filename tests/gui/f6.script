# F6: the sidebar's places and drives, a drive mounted and gone, the headings skipped, the status
# line's forms, the trash view (restore, delete for good, Empty Trash), the tree and hidden
# modes, the mode remembered (f6b.script reads it after a restart). The mount list is
# $OFX_ROOT/mountinfo (OFX_TEST_MOUNTINFO); run.sh makes the tree, the bookmark Bee, the list.
settle
expect sidemode=places sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network trash=0 trashfull=0 trashicon=user-trash
# ofx keeps no folder busy by its own working directory (F6.1 review)
sh test "$(readlink /proc/$(cat "$OFX_ROOT/run.pid")/cwd)" = /
wait-for 2000 spaced=1
# A drive mounted, and gone again
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n50 33 8:17 / %s rw - vfat /dev/sdz1 rw\n' "$OFX_ROOT/media/OFXUSB" > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|OFXUSB|^Network|Browse_Network
# The pointer over a drive: its used space in place of its free; a removable one's eject button
# in its icon's place (F6.1). The fake udisksctl logs; a step named in udisks-fail fails.
point-ui side-row 5
hover-here
expect sidehover=5 hovernum=used ejectbtn=0
shot f61-used.png
point-ui side-row 6
hover-here
wait-for 2000 sidehover=6 ejectbtn=1 hovernum=used
point-ui side-row 3
hover-here
expect hovernum=-
point-ui side-row 6
hover-here
expect hovernum=used
shot f61-hover.png
point-ui side-eject 6
hover-here
click-here
wait-for 3000 status=OFXUSB
expect status=OFXUSB can be removed now
sh grep -qx "udisksctl unmount -b /dev/sdz1" "$OFX_ROOT/spawn.log" && grep -qx "udisksctl power-off -b /dev/sdz1" "$OFX_ROOT/spawn.log"
sh echo unmount > "$OFX_ROOT/udisks-fail"
click-here
wait-for 3000 status=Can't
expect status=Can't eject OFXUSB: Error unmount: target is busy
sh echo power-off > "$OFX_ROOT/udisks-fail"
click-here
wait-for 3000 status=OFXUSB
expect status=OFXUSB is unmounted, but didn't power off: Error power-off: target is busy
sh rm "$OFX_ROOT/udisks-fail"
# Not while a job of ofx's writes there: an 8 MiB copy onto the drive, slowed
key ctrl-l
type ../big.bin
key enter
expect sel=big.bin cwdavail=1
key ctrl-c
key ctrl-l
type media/OFXUSB
key enter
wait-for 2000 cwdavail=1 n=0
key ctrl-v
wait-for 2000 jobs=1
point-ui side-row 6
hover-here
point-ui side-eject 6
click-here
expect status=OFXUSB is in use by a job: wait until it ends
wait-for 6000 jobs=0 n=1
key alt-left
key alt-left
expect sel=adir
point-ui side-row 0
hover-here
expect sidehover=0 hovernum=- ejectbtn=0
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n' > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network
# The cursor skips the headings
key tab
# (on File System, the place shown)
expect sidefocus=1 side=5
key home
expect side=1 place=Home
key up
expect side=1
key end
expect side=7
key up
expect side=5
key up
expect side=3 place=Trash
key up
expect side=2 place=Bee
key esc
expect sidefocus=0
# The status line: one folder marked (its count once known), two, one file; a message until the
# next key
expect sel=adir
key space
wait-for 2000 marked=1 info="adir"_selected_(1_item)
key space
expect info=2_items_selected
key esc
expect marked=0 sel=a.txt
key space
expect info="a.txt"_selected_(3_B)
key esc
char t
expect status=terminal
key down
expect status=-
# Trash a.txt and adir; the Trash place lists them, folders first; its icon is the full one
# (2026-10-30)
press 2
expect sel=a.txt
key delete
wait-for 2000 n=4
wait-for 2000 trashfull=1 trashicon=user-trash-full
shot f6-trash-full.png
press 0
expect sel=adir
key delete
wait-for 2000 n=3
key tab
key home
char j
char j
expect place=Trash
key enter
expect trash=1 n=2 sel=adir crumbs=Trash here=Trash datecol=Deleted
key esc
expect sidefocus=0
# No folder above the trash view: Backspace stays (2026-10-28: it went to "trash:", an error)
key backspace
expect trash=1 crumbs=Trash status=-
# Another program trashes a file: the view follows the home trash
sh printf x > "$OFX_ROOT/data/Trash/files/other.txt" && printf '[Trash Info]\nPath=/elsewhere/other.txt\nDeletionDate=2026-01-02T03:04:05\n' > "$OFX_ROOT/data/Trash/info/other.txt.trashinfo"
wait-for 3000 n=3
sh rm "$OFX_ROOT/data/Trash/files/other.txt" "$OFX_ROOT/data/Trash/info/other.txt.trashinfo"
wait-for 3000 n=2
shot f6-trash.png
# A folder doesn't open there; a rename, a copy, a terminal don't work
key enter
expect status=adir trash=1
key f2
expect editing=0 status=That
key ctrl-c
expect clip=1 status=That
char t
expect status=That
# r restores a.txt
key down
expect sel=a.txt
char r
expect status=Restored
sh test -f "$OFX_ROOT/tree/a.txt" && test ! -e "$OFX_ROOT/data/Trash/info/a.txt.trashinfo"
wait-for 2000 n=1
# Shift+Delete: adir and its .trashinfo, for good
key shift-delete
expect modal=delete
char y
wait-for 3000 n=0 job=-
expect status=Deleted 1 item
sh test ! -e "$OFX_ROOT/data/Trash/files/adir" && test ! -e "$OFX_ROOT/data/Trash/info/adir.trashinfo"
# Two more trashed; Empty Trash asks, Esc keeps them, Yes deletes all
key alt-left
expect trash=0 n=4
press 2
expect sel=b.txt
key delete
wait-for 2000 n=3
press 2
expect sel=c.txt
key delete
wait-for 2000 n=2
# and a trashed folder that can't be deleted (a locked folder in it): its .trashinfo stays with it
sh mkdir -p "$OFX_ROOT/data/Trash/files/locked/sub" && touch "$OFX_ROOT/data/Trash/files/locked/sub/x" && chmod 500 "$OFX_ROOT/data/Trash/files/locked/sub" && printf '[Trash Info]\nPath=/elsewhere/locked\n' > "$OFX_ROOT/data/Trash/info/locked.trashinfo"
key alt-right
wait-for 3000 trash=1 n=3
point-ui trash-empty
click-here
expect modal=empty
shot f6-empty.png
key esc
expect modal=- n=3
click-here
expect modal=empty
char y
wait-for 4000 n=1 job=-
expect sel=locked status=Emptied the trash; 1 failed:
sh test "$(cd "$OFX_ROOT/data/Trash" && find files info -mindepth 1 -maxdepth 1 | sort | tr '\n' ' ')" = "files/locked info/locked.trashinfo "
sh chmod 700 "$OFX_ROOT/data/Trash/files/locked/sub" && rm -r "$OFX_ROOT/data/Trash/files/locked" "$OFX_ROOT/data/Trash/info/locked.trashinfo"
wait-for 3000 n=0
# emptied by another program: the icon follows (the trash folder's watch)
wait-for 2000 trashfull=0 trashicon=user-trash
# The trash works on after it (its folders kept, emptied)
key alt-left
press 1
expect sel=a.txt
key delete
wait-for 2000 n=1
sh test -f "$OFX_ROOT/data/Trash/files/a.txt"
wait-for 2000 trashfull=1
key ctrl-z
wait-for 2000 n=2
wait-for 2000 trashfull=0
# another program trashing into it, then taking it out
sh printf x > "$OFX_ROOT/data/Trash/files/o.txt"
wait-for 2000 trashfull=1 trashicon=user-trash-full
sh rm "$OFX_ROOT/data/Trash/files/o.txt"
wait-for 2000 trashfull=0
# The trash's files/ opened as a folder shares its watch with the trash's (one per inode): the
# trash watches armed again (a mount change) keep the folder's, and leaving it keeps the trash's
key ctrl-l
type ../data/Trash/files
key enter
wait-for 2000 n=0 cwdavail=1
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n50 33 8:17 / %s rw - vfat /dev/sdz1 rw\n' "$OFX_ROOT/media/OFXUSB" > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|OFXUSB|^Network|Browse_Network
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n' > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network
sh printf x > "$OFX_ROOT/data/Trash/files/o.txt"
wait-for 2000 n=1 trashfull=1
# the folder's own watch kept its mask: a write shows (review, 2026-10-30: it was replaced)
sh printf yy >> "$OFX_ROOT/data/Trash/files/o.txt"
wait-for 2000 sizecell=3_B
sh rm "$OFX_ROOT/data/Trash/files/o.txt"
wait-for 2000 n=0 trashfull=0
# no longer a trash (its info/ gone) while open: its watch dropped as a trash's stays the folder's
sh mv "$OFX_ROOT/data/Trash/info" "$OFX_ROOT/data/Trash/info.away"
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n50 33 8:17 / %s rw - vfat /dev/sdz1 rw\n' "$OFX_ROOT/media/OFXUSB" > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|OFXUSB|^Network|Browse_Network
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n' > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network
sh printf z > "$OFX_ROOT/data/Trash/files/p.txt"
wait-for 2000 n=1
sh rm "$OFX_ROOT/data/Trash/files/p.txt"
wait-for 2000 n=0
sh mv "$OFX_ROOT/data/Trash/info.away" "$OFX_ROOT/data/Trash/info"
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n50 33 8:17 / %s rw - vfat /dev/sdz1 rw\n' "$OFX_ROOT/media/OFXUSB" > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|OFXUSB|^Network|Browse_Network
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n' > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network
key alt-left
wait-for 2000 n=2
sh printf x > "$OFX_ROOT/data/Trash/files/o.txt"
wait-for 2000 trashfull=1
sh rm "$OFX_ROOT/data/Trash/files/o.txt"
wait-for 2000 trashfull=0
# A trash folder made on a drive already mounted: no watch yet, so the trash view finds it (and
# the icon follows)
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n50 33 8:17 / %s rw - vfat /dev/sdz1 rw\n' "$OFX_ROOT/media/OFXUSB" > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|OFXUSB|^Network|Browse_Network trashfull=0
sh d="$OFX_ROOT/media/OFXUSB/.Trash-$(id -u)" && mkdir -p "$d/files" "$d/info" && printf x > "$d/files/u.txt" && printf '[Trash Info]\nPath=u.txt\n' > "$d/info/u.txt.trashinfo"
key tab
key home
char j
char j
key enter
wait-for 2000 trash=1 n=1 sel=u.txt trashfull=1
key esc
key alt-left
wait-for 2000 trash=0
sh rm -r "$OFX_ROOT/media/OFXUSB/.Trash-$(id -u)"
wait-for 2000 trashfull=0
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n' > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network
# A drive mounted with something in its own trash: full; unmounted: empty again
sh d="$OFX_ROOT/media/OFXUSB/.Trash-$(id -u)" && mkdir -p "$d/files" "$d/info" && printf x > "$d/files/u.txt" && printf '[Trash Info]\nPath=u.txt\n' > "$d/info/u.txt.trashinfo"
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n50 33 8:17 / %s rw - vfat /dev/sdz1 rw\n' "$OFX_ROOT/media/OFXUSB" > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|OFXUSB|^Network|Browse_Network trashfull=1
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n' > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network trashfull=0
sh rm -r "$OFX_ROOT/media/OFXUSB/.Trash-$(id -u)"
# The tree: F9, opened down to the folder shown, the cursor on it; Left and Right
key f9
expect sidemode=tree treehere=1 treecur=tree:0
sh grep -qx sidebar=tree "$OFX_ROOT/state/ofx/state"
key tab
char l
expect treecur=tree:1 treehere=1
char l
expect treecur=bdir:0 treehere=0
char h
expect treecur=tree:1
char h
expect treecur=tree:0
char h
expect treecur=f6:1
# f6 closed: the folder shown (tree) has no row; Tab's cursor goes to the nearest folder above
# it that has one (Michael, 2026-10-30)
char h
expect treecur=f6:0
key esc
key tab
expect sidefocus=1 treecur=f6:0
char l
expect treecur=f6:1
key enter
expect treecur=f6:1 treehere=1
# A drive mounted while the tree shows, its cursor on a row past the 64th (many/zz, after 70
# folders): the tree stays, its cursor too
key ctrl-l
type many/zz
key enter
expect treecur=zz:0 treehere=1
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n50 33 8:17 / %s rw - vfat /dev/sdz1 rw\n' "$OFX_ROOT/media/OFXUSB" > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|OFXUSB|^Network|Browse_Network
expect sidemode=tree treecur=zz:0 treehere=1 place=-
sh printf '33 1 0:31 / / rw - btrfs /dev/x rw\n' > "$OFX_ROOT/mountinfo"
wait-for 3000 sides=^Places|Home|Bee|Trash|^Drives|File_System|^Network|Browse_Network
key alt-left
key alt-left
expect sel=a.txt treehere=1
shot f6-tree.png
# Hidden: no sidebar; remembered. Tab, and Ctrl+Left (GLFW's 263, Ctrl 2), show it as places and
# give it the keys (Michael, 2026-10-24); hidden again, it takes them back.
key f9
expect sidemode=hidden
sh grep -qx sidebar=hidden "$OFX_ROOT/state/ofx/state"
key tab
expect sidemode=places sidefocus=1
key f9
key f9
expect sidemode=hidden sidefocus=0
raw-key 263 2
expect sidemode=places sidefocus=1
# Ctrl+S (83) is F9: tree, then hidden, for f6b
raw-key 83 2
expect sidemode=tree
raw-key 83 2
expect sidemode=hidden sidefocus=0
sh grep -qx sidebar=hidden "$OFX_ROOT/state/ofx/state"
shot f6-hidden.png
quit
