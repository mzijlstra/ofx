# F16 step 7e: Browse Network (run.sh's f16v): a stand-in avahi-browse that answers for _smb._tcp
# with YOGA (and Office once <T>/office is made) and for _sftp-ssh._tcp with YOGA and box, nothing
# at all once <T>/none is made, two seconds late once <T>/slow is; a stand-in gio as f16s's.
settle
# The Network section's first row, always there; nothing asked of the network until it is visited.
wait-for 4000 sides=^Places|Home|Trash|^Drives|File_System|^Network|Browse_Network
expect network=0 browseasks=0
sh ! grep -q avahi-browse "$OFX_ROOT/spawn.log"
# Visited: both types asked at once; the servers as rows, Kind and Address in their columns, a
# server's icon.
point-side Browse Network
click-here
wait-for 4000 network=1 browseasks=1 n=3 sel=box sizecell=SFTP seldate=fd00::5 info=3_servers
sh grep -q "avahi-browse -k -t -r -p _smb._tcp" "$OFX_ROOT/spawn.log" && grep -q "avahi-browse -k -t -r -p _sftp-ssh._tcp" "$OFX_ROOT/spawn.log"
key down
expect sel=YOGA sizecell=SMB seldate=192.168.1.165
shot f16v-browse.png
# A row pressed and moved isn't dragged: it is a server, not a file (the step 7e review).
point-ui row 1
press-here
move-by 0 40
expect drag=-
release
# Nothing else works on a server's row: said why.
key delete
expect statusbad=1 status=Browse
key f2
expect statusbad=1 status=Browse
# Ctrl+R asks again: Office comes, the cursor stays on its server.
sh touch "$OFX_ROOT/office"
key ctrl-r
wait-for 4000 browseasks=2 n=4 sel=YOGA
# A slow answer: "Searching the network…" until it comes, on a fresh visit (the last rows kept
# on a reload).
key alt-home
wait-for 2000 network=0
sh touch "$OFX_ROOT/slow"
point-side Browse Network
click-here
wait-for 1500 network=1 browseasks=2
expect n=4 info=Searching_the_network…
# Ctrl+R while it runs: another query after it, not a second one at once (the stand-in logs a type
# asked while its last ask runs: the 7e code-health review).
key ctrl-r
wait-for 8000 browseasks=4 n=4
sh [ ! -e "$OFX_ROOT/overlap" ]
sh rm "$OFX_ROOT/slow"
# None found: said so.
sh touch "$OFX_ROOT/none"
key ctrl-r
wait-for 4000 browseasks=5 n=0 listword=No_servers_found
sh rm "$OFX_ROOT/none"
key ctrl-r
wait-for 4000 browseasks=6 n=4
# Enter on an SMB server connects, as its address typed: its shares in the same view, Browse
# Network › the server; Back to the servers.
key home
expect sel=box
key down
expect sel=Office
key enter
wait-for 4000 conn=1
sh grep -q "gio mount smb://office.local:4445" "$OFX_ROOT/spawn.log"
wait-for 6000 conn=0 network=1 n=2 shps=Music|pub info=2_shares
key alt-left
wait-for 4000 network=1 n=4 info=4_servers
# The row's menu: Open and Open in New Tab alone.
point-side Browse Network
right-here
expect menu=folder menuhid=open-window,terminal-in,search-in,cut-it,copy-it,copy-path-it,paste-into,bookmark-it,bm-rename,bm-up,bm-down,bm-remove,bm-edit,unmount-it,eject,mount-it,empty-it,properties-it
point-menu open-tab
click-here
wait-for 4000 tabs=2 network=1
# Go → Browse Network, from home.
key alt-home
wait-for 2000 network=0
point-ui menu-title 3
click-here
point-menu browse-network
click-here
wait-for 4000 network=1
# (the 7e code-health review) A server's row is no folder: its menu has Open, Open in New Tab and
# Copy Path alone; the empty space's has no Properties; a path button's menu is the sidebar row's.
wait-for 4000 n=4 sel=box
point-ui row 0
right-here
expect menu=entry menuhid=containing,open-line,open-window,open-with,cut,copy,paste-into,duplicate,make-link,rename,terminal-in,search-in,follow,bookmark-it,trash,restore,delete,properties
key esc
wait-for 1000 menu=-
point-ui list
right-here
wait-for 1000 menu=here menugrey=new-folder,new-file,empty-trash,paste,terminal,add-bookmark,here-properties
key esc
wait-for 1000 menu=-
point-ui crumb 0
right-here
expect menu=folder menuhid=open-window,terminal-in,search-in,cut-it,copy-it,copy-path-it,paste-into,bookmark-it,bm-rename,bm-up,bm-down,bm-remove,bm-edit,unmount-it,eject,mount-it,empty-it,properties-it
key esc
wait-for 1000 menu=-
# A middle click: an SMB server's shares in a tab of their own; an SFTP server's, said why not.
point-ui row 0
middle-here
expect tabs=2 statusbad=1 status=box:
point-ui row 1
middle-here
wait-for 2000 tabs=3 statusbad=0 tabdirs=network:|Office.local:4445|network:
# That tab: Office's shares, kept (its host however spelled), not read again; Ctrl+R there reads
# them in the same view.
sh [ "$(grep -c "gio mount smb://office.local:4445" "$OFX_ROOT/spawn.log")" -eq 1 ]
key ctrl-tab
wait-for 4000 conn=0 dir=network:smb://Office.local:4445 n=2
sh [ "$(grep -c "gio mount smb://office.local:4445" "$OFX_ROOT/spawn.log")" -eq 1 ]
key ctrl-r
wait-for 4000 conn=1
wait-for 4000 conn=0 dir=network:smb://Office.local:4445 n=2 back=0
quit
