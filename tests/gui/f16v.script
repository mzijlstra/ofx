# F16 step 7b: servers on the network, on a stand-in avahi-browse (run.sh's f16v; OFX_TEST_AVAHI): its
# query finds YOGA (once for IPv4, once for IPv6); its cache reads (every second here) find Office
# too once <T>/office exists, until <T>/gone does. The stand-in gio (f16s's) lists shares. ofx starts in an empty home.
settle
# One query on the network as ofx starts; the server in the Network section, dim (not connected).
wait-for 10000 sides=^Places|Home|Trash|^Drives|File_System|^Network|~YOGA
sh grep -qx "avahi-browse -k -t -r -p _smb._tcp" "$OFX_ROOT/spawn.log"
# Then avahi's cache alone (no query on the network): a server that came, in its place.
sh touch "$OFX_ROOT/office"
wait-for 4000 sides=^Places|Home|Trash|^Drives|File_System|^Network|~Office|~YOGA
sh grep -qx "avahi-browse -k -t -c -r -p _smb._tcp" "$OFX_ROOT/spawn.log"
sh [ "$(grep -c "avahi-browse -k -t -r" "$OFX_ROOT/spawn.log")" -eq 1 ]
shot f16v-servers.png
# A click on a server: its shares (its address, smb://yoga.local).
point-side YOGA
click-here
wait-for 4000 conn=0 shp=1 shpn=2 shps=Music|pub
sh grep -qx "gio mount smb://yoga.local" "$OFX_ROOT/spawn.log"
key esc
wait-for 2000 shp=0
# Its menu: Mount (connects, so its shares again), no bookmark entries.
point-side Office
right-here
expect menu=folder
expect menuhid=open-it,open-tab,open-window,terminal-in,search-in,cut-it,copy-it,copy-path-it,paste-into,bookmark-it,bm-rename,bm-up,bm-down,bm-remove,bm-edit,unmount-it,eject,airplane-off-it,empty-it,properties-it
point-menu mount-it
click-here
wait-for 4000 conn=0 shp=1
sh grep -qx "gio mount smb://office.local:4445" "$OFX_ROOT/spawn.log"
key esc
# Another server in its place (as many as before): the section shows it.
sh touch "$OFX_ROOT/renamed"
wait-for 4000 sides=^Places|Home|Trash|^Drives|File_System|^Network|~Lab|~YOGA
# A server gone from avahi's cache: gone from the section.
sh touch "$OFX_ROOT/gone"
wait-for 4000 sides=^Places|Home|Trash|^Drives|File_System|^Network|~YOGA
quit
