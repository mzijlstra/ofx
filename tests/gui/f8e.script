# The list's Owner and Permissions in an 860 px window (run.sh: OFX_SCRIPT_SIZE): room beside a
# 150 px Name with the sidebar; with Group (Ctrl+G) too there isn't, so they give way and the status
# line says so; without the sidebar they are there and it doesn't. View → Show Colors off and on,
# remembered.
settle
expect permscols=1 permsshown=1 permsnote=0 groupcol=0
key ctrl-g
expect groupcol=1 permsshown=0 permsnote=1
shot list-cramped.png
# No note in the icon view (no columns there), nor with Show Permissions off
key ctrl-2
expect permsnote=0
key ctrl-1
expect permsnote=1
key alt-v
point-menu perms-cols
click-here
expect permscols=0 permsnote=0
key alt-v
point-menu perms-cols
click-here
expect permscols=1 permsnote=1
key f9
key f9
wait-for 2000 sidemode=hidden permsshown=1 permsnote=0
key alt-v
expect menumarked=side-none,perms-cols,group-col,colors,show-menu,sort-name,view-list
point-menu colors
click-here
expect menu=- colors=0
sh grep -qx "colors=off" "$OFX_ROOT/state/ofx/state"
shot list-plain.png
key alt-v
point-menu colors
click-here
expect colors=1
sh grep -qx "colors=on" "$OFX_ROOT/state/ofx/state"
quit
