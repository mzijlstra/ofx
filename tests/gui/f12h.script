# F12 steps 5b and 5c: the branch button after the path buttons, its menu, and switching from it.
# run.sh's repository: main one ahead of its upstream base and one behind; feat-a and feat-b checked
# out after main, then main again (both hold only-a/, main doesn't); other changes a.txt; old0..old9
# older than all.
settle
wait-for 5000 gitshown=1 branch=main_↑1_↓1
# The menu: the one checked out marked, then the reflog's checkouts, then by commit date; 8 at most.
point-ui git-branch
click-here
wait-for 3000 menu=branch brnote=- brn=8
expect brhere=0 menumarked=br-0 brlist=main|feat-b|feat-a|base|other|old0|old1|old2
# Under the button, its left edge; the path buttons give it their room.
expect brunder=1 brfits=1
shot branch-menu.png
# The one checked out picked: nothing.
point-menu br-0
click-here
expect menu=- status=-
# By keyboard (Ctrl+K, then Right past the last path button): feat-a. The folder listed again: it has
# only-a/ now.
key ctrl-k
key right
expect crumbkey=branch
key enter
wait-for 3000 menu=branch brn=8 menuat=br-0
key down
key down
expect menuat=br-2
key enter
wait-for 5000 branch=feat-a
expect statusbad=0 status=Switched to feat-a (on feat-a now)
wait-for 3000 n=2
# Into only-a, then to main: it isn't there, so the window goes up to the repository.
char /
type only-a
key enter
key enter
wait-for 3000 n=1 sel=x.txt
wait-for 5000 branch=feat-a
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
expect brhere=0 brlist=feat-a|main|feat-b|base|other|old0|old1|old2
point-menu br-1
click-here
wait-for 5000 branch=main_↑1_↓1
expect statusbad=0 status=Switched to main: only-a isn't on it
expect n=1 sel=a.txt
# A local change the switch would overwrite: git's refusal, in the status line; HEAD stays.
sh printf 'mine\n' > "$OFX_DIR/a.txt"
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
expect brlist=main|feat-a|feat-b|base|other|old0|old1|old2
point-menu br-4
click-here
wait-for 5000 statusbad=1
expect branch=main_↑1_↓1
expect status=git switch other: Your local changes to the following files would be overwritten by checkout:
sh cd "$OFX_DIR" && GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git checkout -q a.txt
# A slow one (the wrapper's second over base): the menu opened meanwhile says so; past the test's
# half second it carries on, said, and lands (the HEAD watch).
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
point-menu br-3
click-here
expect status=Switching to base…
point-ui git-branch
click-here
wait-for 3000 menu=branch
expect brnote=Switching_to_base… brn=0
key esc
wait-for 5000 branch=base
expect statusbad=0 status=git switch base: still switching after 0.5 s; it carries on
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
expect brlist=base|main|feat-a|feat-b|other|old0|old1|old2 brhere=0
point-menu br-1
click-here
wait-for 5000 branch=main_↑1_↓1
# All of them (step 6): 15 branches, the menu's 8 and "All branches… (15)", which opens the panel;
# typed, it narrows (case folded); Enter switches as the menu does. Then back to main from the menu.
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
expect brtotal=15
point-menu br-all
click-here
wait-for 3000 modal=branches brp=1 brpn=15 brpsel=main
shot branch-panel.png
# Down into the list; a press on the field gives it the keys back.
key down
expect brpinlist=1
point-ui brp-field
click-here
expect brpinlist=0
type OLD7
expect brpn=1 brpsel=old7 brptext=OLD7
key enter
wait-for 5000 branch=old7
expect brp=0 modal=-
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
point-menu br-1
click-here
wait-for 5000 branch=main_↑1_↓1
# A second press closes it, as a menu title's does.
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
click-here
expect menu=-
# Detached (a checkout from a terminal: HEAD written, asked again): the commit's short id, none
# marked.
sh cd "$OFX_DIR" && GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git checkout -q --detach
wait-for 5000 branch=1319d8b
point-ui git-branch
click-here
wait-for 3000 menu=branch brn=8
expect brhere=-1 brlist=main|old7|base|feat-a|feat-b|other|old0|old1
key esc
expect menu=-
# Outside the repository: no button.
key backspace
wait-for 3000 gitshown=0 branch=-
# A repository with no commit yet: its branch, and no branches to list. The name is long: the button
# takes its third of the room, and the path buttons still aren't squeezed under it.
key ctrl-l
type folder-01/folder-02/folder-03/folder-04/folder-05/folder-06/folder-07/folder-08/folder-09/folder-10/folder-11/folder-12/unborn
key enter
wait-for 5000 gitshown=1 branch=a-branch-name-long-enough-to-take-its-third-of-the-room
expect brfits=1
shot branch-long.png
point-ui git-branch
click-here
wait-for 3000 menu=branch brnote=No_local_branches
expect brn=0 brhere=-1
key esc
# A branch name past the menu's 360 px, checked out last: the menu draws it cut, and is placed by its
# drawn width (the F15 code-health review: menu_size measured the whole name, so the menu sat as
# far left as the whole name would have needed).
sh cd "$OFX_ROOT/tree/repo" && export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null && git branch b-a-branch-name-that-is-very-much-longer-than-the-three-hundred-and-sixty-pixels-a-menu-gives-a-label-so-it-is-cut && git switch -q b-a-branch-name-that-is-very-much-longer-than-the-three-hundred-and-sixty-pixels-a-menu-gives-a-label-so-it-is-cut && git switch -q main
key ctrl-l
type ../../../../../../../../../../../../../repo
key enter
wait-for 5000 gitshown=1 branch=main_↑1_↓1
point-ui git-branch
click-here
wait-for 3000 menu=branch brnote=- brn=8
expect menusized=1
key esc
quit
