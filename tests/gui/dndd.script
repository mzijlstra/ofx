# F14 step 1: a drag out of ofx (drag-out, from vptr's press held on the window) dropped on another
# program (dndpeer target, the right half): offered as files, text and ofx's own type, copy only
# unless asked; the target reads the files on our writer thread and finishes. Layout as dnd.script.
settle
sh dndpeer target "$OFX_ROOT/peer.log" >/dev/null 2>&1 &
sleep 800
settle
expect dndout=none dndpress=0 sel=adir
key down
sh vptr move 200 300 press wait 1500 move 300 300 move 650 250 move 700 250 wait 300 release >"$OFX_ROOT/vptr.log" 2>&1 &
wait-for 3000 dndpress=1
drag-out
expect dndout=dragging
wait-for 4000 dndout=done dndoutact=1 dndwrote=1
sh grep -q "received [0-9]* bytes: file://$OFX_DIR/a.txt" "$OFX_ROOT/peer.log"
sh grep -q "offer type text/uri-list" "$OFX_ROOT/peer.log" && grep -q "offer type text/plain;charset=utf-8" "$OFX_ROOT/peer.log" && grep -q "offer type application/x-ofx-drag-" "$OFX_ROOT/peer.log"
sh grep -q "source actions 1$" "$OFX_ROOT/peer.log"
sh test -f "$OFX_DIR/a.txt"
quit
