# F15 step 2: ofx.conf's key lines, applied when the file is saved. A key bound acts, the default
# it took no longer does (it says so once), the menu shows your key, a line ofx can't read is named
# and the rest apply, none takes a command's keys. The tree (run.sh): a/, b/, c.txt.
settle
expect n=3 tabs=1 keysbad=0 keyclashes=0
key f10
expect menu=File menukeys=new-tab=Ctrl+T,reopen-tab=Ctrl+Shift+T,new-window=Ctrl+N,new-folder=Ctrl+Shift+N,open=Enter,open-with=Shift+Enter,properties=Ctrl+I,close-all=Ctrl+Q,close=Ctrl+W
key esc
sh printf 'key = Ctrl+T reload\nkey = Ctrl+E new-tab\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 keysbad=0 keyclashes=1 statusbad=0 status=ofx.conf: Ctrl+T is reload now,
key ctrl-t
expect tabs=1
key ctrl-e
expect tabs=2
key f10
expect menu=File menukeys=new-tab=Ctrl+E,reopen-tab=Ctrl+Shift+T,new-window=Ctrl+N,new-folder=Ctrl+Shift+N,open=Enter,open-with=Shift+Enter,properties=Ctrl+I,close-all=Ctrl+Q,close=Ctrl+W
key esc
# Keyboard Shortcuts (step 3): New Tab's row shows Ctrl+E, marked as yours; its name finds it
key f1
type new-tab
expect keys=1 keysn=2 keysfirst=#Tabs_and_windows keyscap=Ctrl+E keyscapmine=1
shot f15-keys.png
key esc
# A line ofx can't read: named, the rest apply (Ctrl+T is New Tab's again)
sh printf 'key = Ctrl+T nosuch\nkey = Ctrl+E new-tab\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 keysbad=1 statusbad=1
key ctrl-t
expect tabs=3
# none: New Tab keeps no key
sh printf 'key = none new-tab\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 keysbad=0 keyclashes=0
key ctrl-t
expect tabs=3
key f10
expect menukeys=reopen-tab=Ctrl+Shift+T,new-window=Ctrl+N,new-folder=Ctrl+Shift+N,open=Enter,open-with=Shift+Enter,properties=Ctrl+I,close-all=Ctrl+Q,close=Ctrl+W
key esc
# A clash saved beside a typo: the typo's line is said first, the clash once the typo is fixed
sh printf 'key = Ctrl+W reload\nkey = Ctrl+Bogus find\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 keysbad=2 statusbad=1
sh printf 'key = Ctrl+W reload\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 keysbad=0 statusbad=0 status=ofx.conf: Ctrl+W is reload now,
# The same beside a line no option reads (ofx.conf's own bad line)
sh printf 'key = Ctrl+N reload\nbogus-option = 1\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 keysbad=0 statusbad=1
sh printf 'key = Ctrl+N reload\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 statusbad=0 status=ofx.conf: Ctrl+N is reload now,
# A clash in the file at the start isn't said (only after a save that changed the keys): f15b
sh printf 'key = Ctrl+T reload\n' > "$OFX_ROOT/config/ofx/ofx.conf"
wait-for 3000 keyclashes=1 status=ofx.conf: Ctrl+T is reload now,
quit
